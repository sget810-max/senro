{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "senro:booster_locomotive",
      "runtime_identifier": "minecraft:minecart",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "senro:yaw": {
          "type": "float",
          "range": [
            -180.0,
            180.0
          ],
          "default": 0.0,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "minecart",
          "inanimate",
          "senro_booster"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.98,
        "height": 0.7
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "interact_text": "action.interact.ride.minecart",
        "pull_in_entities": false,
        "seats": {
          "position": [
            0.0,
            0.7,
            0.0
          ]
        }
      },
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 60.0,
          "max_dropped_ticks": 20,
          "use_motion_prediction_hints": true
        },
        "conditional_values": [
          {
            "max_optimized_distance": 0.0,
            "max_dropped_ticks": 0,
            "conditional_values": [
              {
                "test": "is_moving",
                "subject": "self",
                "operator": "==",
                "value": true
              }
            ]
          }
        ]
      },
      "minecraft:pushable_by_entity": {
        "presets": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "has_tag",
                  "subject": "self",
                  "value": "senro_coupled"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "senro_coupled"
                }
              ]
            },
            "push_mode": "none"
          },
          {
            "push_mode": "legacy_minecart",
            "strength_multiplier": 0.1,
            "min_distance": 0.01,
            "push_scale_self": 0.5,
            "push_scale_other": 0.25
          }
        ]
      },
      "minecraft:pushable_by_block": {}
    },
    "component_groups": {
      "senro:speed_normal": {
        "minecraft:rail_movement": {
          "max_speed": 0.4
        }
      },
      "senro:speed_15": {
        "minecraft:rail_movement": {
          "max_speed": 0.6
        }
      },
      "senro:speed_20": {
        "minecraft:rail_movement": {
          "max_speed": 0.8
        }
      },
      "senro:stackable": {
        "minecraft:is_stackable": {}
      }
    },
    "events": {
      "senro:speed_normal": {
        "remove": {
          "component_groups": [
            "senro:speed_15",
            "senro:speed_20"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_normal"
          ]
        }
      },
      "senro:speed_15": {
        "remove": {
          "component_groups": [
            "senro:speed_normal",
            "senro:speed_20"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_15"
          ]
        }
      },
      "senro:speed_20": {
        "remove": {
          "component_groups": [
            "senro:speed_normal",
            "senro:speed_15"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_20"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "senro:speed_normal",
            "senro:speed_normal",
            "senro:stackable"
          ]
        }
      },
      "senro:unstack": {
        "remove": {
          "component_groups": [
            "senro:stackable"
          ]
        }
      },
      "senro:stack": {
        "add": {
          "component_groups": [
            "senro:stackable"
          ]
        }
      }
    }
  }
}