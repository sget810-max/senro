{
  "format_version": "1.26.30",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:chest_minecart",
      "is_experimental": false,
      "is_summonable": true,
      "is_spawnable": false,
      "spawn_category": "misc"
    },
    "components": {
      "minecraft:collision_box": {
        "height": 0.7,
        "width": 0.98
      },
      "minecraft:conditional_bandwidth_optimization": {
        "conditional_values": [
          {
            "conditional_values": [
              {
                "operator": "==",
                "test": "is_moving",
                "subject": "self",
                "value": true
              }
            ],
            "max_dropped_ticks": 0,
            "max_optimized_distance": 0.0
          }
        ],
        "default_values": {
          "max_dropped_ticks": 20,
          "max_optimized_distance": 60.0,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:inventory": {
        "can_be_siphoned_from": true,
        "inventory_size": 27,
        "container_type": "minecart_chest"
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {
        "presets": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "has_tag",
                  "subject": "self",
                  "value": "senro_coupled"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "senro_coupled"
                }
              ]
            },
            "push_mode": "none"
          },
          {
            "push_mode": "legacy_minecart",
            "strength_multiplier": 0.1,
            "min_distance": 0.01,
            "push_scale_self": 0.5,
            "push_scale_other": 0.25
          }
        ]
      },
      "minecraft:pushable_by_block": {},
      "minecraft:type_family": {
        "family": [
          "minecart",
          "inanimate"
        ]
      }
    },
    "events": {
      "senro:speed_normal": {
        "remove": {
          "component_groups": [
            "senro:speed_15",
            "senro:speed_20"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_normal"
          ]
        }
      },
      "senro:speed_15": {
        "remove": {
          "component_groups": [
            "senro:speed_normal",
            "senro:speed_20"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_15"
          ]
        }
      },
      "senro:speed_20": {
        "remove": {
          "component_groups": [
            "senro:speed_normal",
            "senro:speed_15"
          ]
        },
        "add": {
          "component_groups": [
            "senro:speed_20"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "senro:speed_normal",
            "senro:stackable"
          ]
        }
      },
      "senro:unstack": {
        "remove": {
          "component_groups": [
            "senro:stackable"
          ]
        }
      },
      "senro:stack": {
        "add": {
          "component_groups": [
            "senro:stackable"
          ]
        }
      }
    },
    "component_groups": {
      "senro:speed_normal": {
        "minecraft:rail_movement": {
          "max_speed": 0.4
        }
      },
      "senro:speed_15": {
        "minecraft:rail_movement": {
          "max_speed": 0.6
        }
      },
      "senro:speed_20": {
        "minecraft:rail_movement": {
          "max_speed": 0.8
        }
      },
      "senro:stackable": {
        "minecraft:is_stackable": {}
      }
    }
  }
}